# --- App ---
# Public name shown in the UI. Rebrand by changing this value.
SITE_NAME=Tarteeb
# Secret used to encrypt user-supplied AI keys at rest (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# HTTPS origin required in production; local development uses localhost
APP_URL=http://localhost:3000

# --- Supabase (optional for local dev, required for production) ---
# When unset, the app runs on a local file-backed store + dev cookie session.
# Set both to use Supabase Postgres + Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (operator key, optional) ---
# Default is user-supplied keys (BYOK) stored per-user in Settings.
# If AI_OPERATOR_KEY is set, it is used as a fallback when the user has no key.
# AI_OPERATOR_MODEL sets the default model for the operator key.
AI_OPERATOR_KEY=
AI_OPERATOR_MODEL=gpt-4o-mini
# Comma-separated allowlist of models users may select.
AI_ALLOWED_MODELS=gpt-4o-mini,gpt-4o
# AI provider base URL. Do NOT make this user-configurable (SSRF risk).
AI_BASE_URL=https://api.openai.com/v1
# Request timeout (ms) for AI calls.
AI_TIMEOUT_MS=45000
# Max pasted client-message characters per intake message (hard ceiling 12000).
AI_MAX_INPUT_CHARS=12000

# Other Node hosts only: set 1 when a trusted reverse proxy overwrites X-Forwarded-For.
# Vercel does not need this setting.
TRUST_PROXY=0
